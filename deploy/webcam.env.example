# Optional runtime configuration for the webcam systemd service.
# Copy this file to `webcam.env` (alongside the .service file's EnvironmentFile
# path) and uncomment / edit the values you want to override. Anything left
# commented falls back to the defaults baked into app.py.
#
# Note: this file is parsed by systemd's EnvironmentFile=, NOT by a shell.
# Do not use shell expansion, command substitution, or quotes around values.

# Streaming frame rate cap (1..60). Lower values reduce CPU usage on Pi Zero 2 W.
#WEBCAM_FPS=15

# Network interface uvicorn binds to. Use 127.0.0.1 to restrict to localhost.
#WEBCAM_HOST=0.0.0.0

# TCP port uvicorn listens on (1..65535).
#WEBCAM_PORT=5000

# Initial camera resolution at startup. Format: WxH, each dim in [16, 4096].
#WEBCAM_DEFAULT_RESOLUTION=640x480
